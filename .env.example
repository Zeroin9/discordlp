# Discord Bot Token
# Get this from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# PostgreSQL Database Connection
# For Docker Compose, use 'db' as the host. For local development, use 'localhost'.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/discordlp
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Pari (custom bets)
# Hours before an open pari is auto-canceled with a full refund (0 to disable)
PARI_TIMEOUT_HOURS=24
# Share of the total pool kept as the organizer's commission (0.05 = 5%, 0 to disable)
PARI_COMMISSION_RATE=0.05

# Weekly activity summary — who was in voice channels during the week
# Channel to post the summary in; leave empty to disable the scheduled post (/lpweek still works)
WEEKLY_SUMMARY_CHANNEL_ID=
# Spring cron expression for the summary; "-" disables the scheduler entirely
WEEKLY_SUMMARY_CRON=0 0 12 * * MON
# Time zone of the schedule and of the dates in the summary header
WEEKLY_SUMMARY_ZONE=Europe/Moscow
# How many past days the summary covers
WEEKLY_SUMMARY_DAYS=7
